/*
  900_seed_super_admin.sql.example  (MS-5075)

  NOT part of the migration run (the .example suffix keeps it out of
  `cat migrations/admin/[0-9]*.sql`). Copy, edit the e-mail, run once by hand.

  The admin API reads the role from app_metadata.role in the access token
  (raw_app_meta_data in auth.users - NOT user_metadata, which the user can
  edit). Roles: super_admin, admin. The user must sign in again (or refresh
  the session) for the new role to appear in the token.
*/

-- Grant super_admin
UPDATE auth.users
   SET raw_app_meta_data = coalesce(raw_app_meta_data, '{}'::jsonb) || '{"role":"super_admin"}'::jsonb
 WHERE email = 'first.admin@example.com';

-- Grant admin (non-super: no settings.write, users.ban, bundles.bulk, referrals.export)
-- UPDATE auth.users
--    SET raw_app_meta_data = coalesce(raw_app_meta_data, '{}'::jsonb) || '{"role":"admin"}'::jsonb
--  WHERE email = 'second.admin@example.com';

-- Remove the admin role (the user keeps a normal storefront account)
-- UPDATE auth.users
--    SET raw_app_meta_data = raw_app_meta_data - 'role'
--  WHERE email = 'former.admin@example.com';

-- Check
