# Supabase Configuration
SUPABASE_URL= #Supabase project URL
SUPABASE_KEY= #Supabase service key for server-side access you can get your api key from https://supabase.com/dashboard/project/{project_id}/settings/api-keys in service_role secret
SUPABASE_ANON_KEY= #Supabase anon/public key for client-side access you can get your api key from https://supabase.com/dashboard/project/{project_id}/settings/api-keys in anon public

# Stripe Configuration
STRIPE_SECRET_KEY= #Stripe secret key (test or live)
STRIPE_PUBLIC_KEY= #Stripe public key for frontend use
STRIPE_WEBHOOK_SECRET= #Stripe webhook signing secret
STRIPE_AUTOMATIC_TAX= #Enable automatic tax calculation (True/False)
STRIPE_TAX_CODE= #Default tax code for products (e.g., 'txcd_10000000')
MERCHANT_ID= #Stripe merchant ID for transaction context
MERCHANT_DISPLAY_NAME= #Display name for the merchant in transactions
MERCHANT_ADDRESS= #Merchant address for transaction context
MERCHANT_PHONE= #Merchant phone number for transaction context
MERCHANT_EMAIL= #Merchant email for transaction context
MERCHANT_WEBSITE= #Merchant website URL for transaction context

# LinkAja Configuration
# All values are optional. With LINKAJA_ENABLED=false (the default) none of them is read,
# and the application starts and runs Card/Wallet/DCB exactly as before.
LINKAJA_ENABLED=false #Fail-closed gate for payment_type="LinkAja". MUST stay false unless this deployment is onboarded with LinkAja. Does NOT select the payment method - the frontend does, via payment_type.

# --- Deployment values: required when LINKAJA_ENABLED=true --------------------
# Values come from the LinkAja merchant onboarding pack (Credential.txt). Never commit real values.
LINKAJA_BASE_URL= #Host only, paths below include /bi. Dev: https://partner-dev.linkaja.com . Production: not yet provided by LinkAja
LINKAJA_CLIENT_ID= #"Clientkey" - sent as X-CLIENT-KEY on the access-token call
LINKAJA_CLIENT_SECRET= #"Secretkey" - HMAC-SHA512 key for service-call signatures. Secret, never log or commit
LINKAJA_PARTNER_ID= #"Partner-ID" - sent as X-PARTNER-ID
LINKAJA_CHANNEL_ID= #Sent as CHANNEL-ID (value in the LinkAja Postman collection)
LINKAJA_MERCHANT_ID= #"merchantID" - body merchantId
LINKAJA_TERMINAL_ID= #Body terminalId (the LinkAja collection uses the merchant ID)
LINKAJA_TERMINAL_NAME= #Body additionalInfo.terminalName (value in the LinkAja Postman collection)
LINKAJA_PRIVATE_KEY= #RSA private key PEM that signs the access-token request ("\n" escapes allowed). Secret
LINKAJA_PRIVATE_KEY_PATH= #Alternative to LINKAJA_PRIVATE_KEY: path to the PEM file. Secret file, never commit
LINKAJA_USD_TO_IDR_RATE= #BUSINESS DECISION PENDING. USD->IDR rate for order amounts (orders are stored in USD, LinkAja takes IDR). Blank = LinkAja payments fail closed
LINKAJA_NOTIFY_URL= #Public URL of our notify endpoint, e.g. https://<host>/bi/applink/v1.0/debit/notify . Sent as urlParams[0].url (type PAY_RETURN), as LinkAja confirmed. Both POST /api/v1/callback/linkaja and POST /bi/applink/v1.0/debit/notify are served
LINKAJA_URL_PARAM_IS_DEEPLINK=N #urlParams[].isDeeplink (spec p.11: Y/N). Keep N: the notify URL is a web URL. Blank = N
LINKAJA_SUCCESS_URL= #Not used: LinkAja's urlParams carries the notify URL (LINKAJA_NOTIFY_URL), not a user return page
LINKAJA_CALLBACK_URL= #Not used: superseded by LINKAJA_NOTIFY_URL
LINKAJA_CANCEL_URL= #Not used: LinkAja's API accepts a single return URL
LINKAJA_USER_AGENT=ios #User-Agent sent on payment creation, as in the LinkAja collection; not in the spec

# --- Contract values: "LinkAja Applink SNAP" spec v1.1 (2025-05-08) ------------
# A blank path makes the matching operation fail with LINKAJA_NOT_CONFIGURED
# instead of issuing a guessed request.
LINKAJA_AUTH_PATH=/bi/v1.0/access-token/b2b #Access Token B2B (§4.1)
LINKAJA_CREATE_PAYMENT_PATH=/bi/applink/v1.0/debit/payment-host-to-host #Create Applink Payment (§4.2)
LINKAJA_PAYMENT_STATUS_PATH=/bi/applink/v1.0/debit/status #Applink Inquiry Status (§4.4)
# Notify (Inform Payment, §4.3) verification. The notify X-SIGNATURE is SHA256withRSA (§5.1.3) and
# is verified with LinkAja's public key. WAITING ON LINKAJA. While blank, EVERY notify is rejected
# (HTTP 503, responseCode 5005601) and no LinkAja payment can provision - fail closed.
LINKAJA_NOTIFY_PUBLIC_KEY= #LinkAja's RSA public key PEM ("\n" escapes allowed). NOT the public-key.txt from the credential pack - that one is the pair of OUR private key
LINKAJA_NOTIFY_PUBLIC_KEY_PATH= #Alternative to LINKAJA_NOTIFY_PUBLIC_KEY: path to the PEM file
LINKAJA_NOTIFY_ENDPOINT_URL= #The "EndpointUrl" LinkAja puts in the notify string-to-sign (§5.1.3). Blank = the path LinkAja actually called (e.g. /bi/applink/v1.0/debit/notify). Set to the full URL if LinkAja confirms they sign that instead

# --- Reconciliation -----------------------------------------------------------
# LinkAja does not retry its notify, so pending LinkAja orders are polled with Inquiry Status (§4.4).
# The job runs only when LINKAJA_ENABLED=true at startup. Blank = the default shown.
LINKAJA_RECONCILE_INTERVAL_SECONDS=120 #How often the job runs
LINKAJA_RECONCILE_MIN_AGE_SECONDS=60 #Orders younger than this are left to the notify
LINKAJA_RECONCILE_MAX_AGE_SECONDS=86400 #Orders older than this are no longer polled
LINKAJA_RECONCILE_BATCH_SIZE=100 #Most recent pending LinkAja orders read per run

# --- Transport ----------------------------------------------------------------
LINKAJA_CONNECT_TIMEOUT=10 #Connection timeout in seconds for outbound LinkAja calls
LINKAJA_READ_TIMEOUT=30 #Read timeout in seconds for outbound LinkAja calls

# eSIM Hub Configuration
ESIM_HUB_BASE_URL= #Base URL for primary eSIM hub API
ESIM_HUB_BASE_URL2= #Base URL for secondary eSIM hub API
ESIM_HUB_API_KEY= #API key for accessing the eSIM hub
ESIM_HUB_TENANT_KEY= #Tenant key for the eSIM hub integration


# Firebase Cloud Messaging
FCM_CONFIG_FILE= #Path to Firebase service account JSON file

# Email / SMTP Configuration
SMTP_SERVER= #SMTP server address
SMTP_PORT= #SMTP server port (e.g., 587)
SMTP_USERNAME= #SMTP username/login email
SMTP_PASSWORD= #SMTP password or SMTP API key
SMTP_USE_TLS= #Use TLS for SMTP connection (True/False)
SMTP_SENDER= #Default sender email address for outgoing emails
SMTP_SENDER_NAME= #Default sender name for outgoing emails
SUPPORT_EMAIL= #Support contact email address

# App Defaults
DEFAULT_CURRENCY= #Default currency for transactions (e.g., USD, GBP)
ENVIRONMENT=Prod #Environment type (DEV, QA, PROD)
PAYMENT_METHODS=Card #Comma-separated list of enabled payment methods (e.g., otp, card)
WHATSAPP_NUMBER= #Whatsapp number for customer support
SCHEDULER_INTERVAL_SECONDS= #Interval in seconds for the scheduler to run sync exchange price tasks
GLOBAL_COUNTRIES_COUNT= #Minimum number of countries supported in global eSIM plans
EMAIL_TEMPLATES_PATH= #Path to the directory containing email templates
FORBIDDEN_COUNTRIES= #Comma-separated list of country codes where services are restricted
MAX_DAILY_TOP_UP_COUNT= #Maximum number of successful wallet top-ups allowed per rolling 24 hours (default 2)

# MCP purchase adapter (/api/v1/mcp/...) - all flags default to OFF (fail closed).
# None of these variables is read by the website, the mobile application or the Stripe
# webhook; changing them affects only the /api/v1/mcp/... routes.
MCP_PURCHASE_ENABLED=false #Master switch for every MCP purchase endpoint (true/1/yes/on)
MCP_CARD_PURCHASE_ENABLED=false #Switch for the MCP card checkout endpoints; also requires MCP_PURCHASE_ENABLED
MCP_CARD_SUCCESS_URL= #Absolute https URL the payment provider returns a paying customer to. Landing there marks nothing paid.
MCP_CARD_CANCEL_URL= #Absolute https URL the payment provider returns a customer who abandoned the page to
MCP_CARD_SESSION_EXPIRY_MINUTES=31 #Hosted payment page lifetime in minutes (clamped to 31..1439)
