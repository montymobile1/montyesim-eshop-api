# Supabase Configuration
SUPABASE_URL= #Supabase project URL
SUPABASE_KEY= #Supabase service key for server-side access you can get your api key from https://supabase.com/dashboard/project/{project_id}/settings/api-keys in service_role secret
SUPABASE_ANON_KEY= #Supabase anon/public key for client-side access you can get your api key from https://supabase.com/dashboard/project/{project_id}/settings/api-keys in anon public

# Stripe Configuration
STRIPE_SECRET_KEY= #Stripe secret key (test or live)
STRIPE_PUBLIC_KEY= #Stripe public key for frontend use
STRIPE_WEBHOOK_SECRET= #Stripe webhook signing secret
STRIPE_AUTOMATIC_TAX= #Enable automatic tax calculation (True/False)
STRIPE_TAX_CODE= #Default tax code for products (e.g., 'txcd_10000000')
MERCHANT_ID= #Stripe merchant ID for transaction context
MERCHANT_DISPLAY_NAME= #Display name for the merchant in transactions
MERCHANT_ADDRESS= #Merchant address for transaction context
MERCHANT_PHONE= #Merchant phone number for transaction context
MERCHANT_EMAIL= #Merchant email for transaction context
MERCHANT_WEBSITE= #Merchant website URL for transaction context

# eSIM Hub Configuration
ESIM_HUB_BASE_URL= #Base URL for primary eSIM hub API
ESIM_HUB_BASE_URL2= #Base URL for secondary eSIM hub API
ESIM_HUB_API_KEY= #API key for accessing the eSIM hub
ESIM_HUB_TENANT_KEY= #Tenant key for the eSIM hub integration


# Firebase Cloud Messaging
FCM_CONFIG_FILE= #Path to Firebase service account JSON file

# Email / SMTP Configuration
SMTP_SERVER= #SMTP server address
SMTP_PORT= #SMTP server port (e.g., 587)
SMTP_USERNAME= #SMTP username/login email
SMTP_PASSWORD= #SMTP password or SMTP API key
SMTP_USE_TLS= #Use TLS for SMTP connection (True/False)
SMTP_SENDER= #Default sender email address for outgoing emails
SMTP_SENDER_NAME= #Default sender name for outgoing emails
SUPPORT_EMAIL= #Support contact email address

# App Defaults
DEFAULT_CURRENCY= #Default currency for transactions (e.g., USD, GBP)
ENVIRONMENT=Prod #Environment type (DEV, QA, PROD)
PAYMENT_METHODS=Card #Comma-separated list of enabled payment methods (e.g., otp, card)
WHATSAPP_NUMBER= #Whatsapp number for customer support
SCHEDULER_INTERVAL_SECONDS= #Interval in seconds for the scheduler to run sync exchange price tasks
GLOBAL_COUNTRIES_COUNT= #Minimum number of countries supported in global eSIM plans
EMAIL_TEMPLATES_PATH= #Path to the directory containing email templates
FORBIDDEN_COUNTRIES= #Comma-separated list of country codes where services are restricted

# =============================================================================
# MCP (Phase 4A) - isolated wallet purchase endpoint, disabled by default
# =============================================================================
MCP_PURCHASE_ENABLED=false #Enable POST /api/v1/mcp/user/bundle/assign (true/false). Legacy endpoints are unaffected either way

# MANDATORY whenever MCP_PURCHASE_ENABLED=true. The endpoint fails closed (503) without it.
# Generate with:  openssl rand -hex 32
# Minimum 32 characters. Placeholder-looking values ("changeme", "secret", "test"...) are rejected.
#
#   !! THIS SECRET MUST STAY STABLE ACROSS DEPLOYMENTS AND ACROSS EVERY REPLICA !!
#
# It keys the digest of each Idempotency-Key. Changing it re-digests every future key,
# so keys that customers already used stop matching their stored records and look BRAND
# NEW - a replayed purchase would then execute a SECOND time and charge the wallet again.
# Two replicas with different secrets have the same effect concurrently.
# Rotating it therefore requires a migration/runbook (drain in-flight keys, then rotate
# during a quiet window), never a routine config edit. See the SQL migration header.
MCP_IDEMPOTENCY_HASH_SECRET=replace-with-openssl-rand-hex-32 #REQUIRED when MCP is enabled. Must be stable forever

MCP_IDEMPOTENCY_TTL_SECONDS= #Optional. Retention hint written to expires_at (default 86400). Does NOT recycle or unlock terminal keys
MCP_IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS= #Optional. Age at which a PROCESSING record is treated as a crashed execution (default 120)

# X-Currency on the MCP endpoint: omit it, or send SYSTEM_CURRENCY. Any other value is
# rejected with 400 - MCP purchases are settled in the system currency only.
# Note DEFAULT_CURRENCY (a presentation default) is NOT used by the MCP endpoint.
